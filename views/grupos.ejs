<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Gestão de Grupos — SSR Relacional</title>
    <style>
    body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f1f5f9; color: #334155; margin: 30px 20px; }
    .container { max-width: 900px; margin: 0 auto; }
    .header { display: flex; justify-content: space-between; align-items: center; background: #ffffff; padding: 20px 25px; border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); border-top: 4px solid #6366f1; }
    .card-add { background: #ffffff; padding: 25px; margin: 25px 0; border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); }
    .form-inline { display: flex; gap: 12px; align-items: center; }
    .form-inline input { flex: 1; padding: 10px 15px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; transition: all 0.2s; outline: none; }
    .form-inline input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.2); }
    .form-inline button { padding: 10px 18px; background: #6366f1; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500; font-size: 14px; transition: all 0.2s; }
    .form-inline button:hover { background: #4f46e5; transform: translateY(-1px); box-shadow: 0 4px 6px rgba(0,0,0,0.15); }
    table { width: 100%; border-collapse: separate; border-spacing: 0; background: #ffffff; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    th, td { padding: 16px 20px; text-align: left; border-bottom: 1px solid #e2e8f0; }
    th { background-color: #f8fafc; color: #475569; font-weight: 600; text-transform: uppercase; font-size: 13px; letter-spacing: 0.5px; }
    tr:last-child td { border-bottom: none; }
    tr:hover { background-color: #f8fafc; transition: background-color 0.2s ease; }
    .btn-red { background-color: #ef4444; color: white; padding: 8px 14px; text-decoration: none; border-radius: 6px; font-size: 13px; font-weight: 500; transition: all 0.2s ease; display: inline-block; }
    .btn-red:hover { background-color: #dc2626; transform: translateY(-1px); box-shadow: 0 4px 6px rgba(0,0,0,0.15); }
</style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>Cadastro de Grupos de clientes</h2>
            <a href="/clientes" style="color: #007bff; text-decoration: none;">← Voltar para clientes</a>
        </div>

      
        <div class="card-add">
            <h3>Novo Grupo</h3>
            <form action="/grupos/novo" method="POST" class="form-inline">
                <input type="text" name="nome" placeholder="Nome (Ex: VIP, Padrão)" required>
               
                <input type="text" name="descricao_grupo" placeholder="Descrição do grupo..." required>
                <button type="submit">Cadastrar Grupo</button>
            </form>
        </div>

       
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome do Grupo</th>
                    <th>Descrição do Grupo</th>
                    <th>Ações</th> 
                </tr>
            </thead>
            <tbody>
                <% if (grupos.length === 0) { %>
                    <tr>
                        <td colspan="4" style="text-align: center; color: #888;">Nenhum grupo cadastrado.</td>
                    </tr>
                <% } else { %>
                    <% grupos.forEach(grupo => { %>
                        <tr>
                            <td><%= grupo.id %></td>
                            <td><strong><%= grupo.nome %></strong></td>
                            <td><%= grupo.descricao_grupo %></td> 
                            <td>
                                <a href="/grupos/deletar/<%= grupo.id %>" class="btn-red" onclick="return confirm('Atenção: Ao excluir o grupo, os clientes vinculados terão o grupo definido como nulo. Deseja continuar?')">Excluir</a>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>