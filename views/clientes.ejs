<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>clientes — SSR Relacional</title>
    <style>
    body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f1f5f9; color: #334155; margin: 30px auto; max-width: 1200px; padding: 0 20px; }
    .header { display: flex; justify-content: space-between; align-items: center; background: #ffffff; padding: 20px 25px; border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); border-top: 4px solid #4f46e5; }
    .actions { margin: 25px 0; display: flex; justify-content: space-between; align-items: center; }
    table { width: 100%; border-collapse: separate; border-spacing: 0; background: #ffffff; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    th, td { padding: 16px 20px; text-align: left; border-bottom: 1px solid #e2e8f0; }
    th { background-color: #f8fafc; color: #475569; font-weight: 600; text-transform: uppercase; font-size: 13px; letter-spacing: 0.5px; }
    tr:last-child td { border-bottom: none; }
    tr:hover { background-color: #f8fafc; transition: background-color 0.2s ease; }
    .btn { padding: 10px 16px; text-decoration: none; border-radius: 6px; font-size: 14px; font-weight: 500; color: white; display: inline-block; transition: all 0.2s ease; border: none; cursor: pointer; }
    .btn:hover { transform: translateY(-1px); box-shadow: 0 4px 6px rgba(0,0,0,0.15); }
    .btn-green { background-color: #10b981; }
    .btn-green:hover { background-color: #059669; }
    .btn-purple { background-color: #6366f1; }
    .btn-purple:hover { background-color: #4f46e5; }
    .btn-blue { background-color: #3b82f6; }
    .btn-blue:hover { background-color: #2563eb; }
    .btn-red { background-color: #ef4444; }
    .btn-red:hover { background-color: #dc2626; }
    .badge-grupo { background: #e0e7ff; color: #4338ca; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; display: inline-block; }
    .search-box { display: flex; gap: 8px; align-items: center; }
    .search-box input { padding: 10px 15px; border: 1px solid #cbd5e1; border-radius: 6px; width: 250px; font-size: 14px; transition: all 0.2s; }
    .search-box input:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.2); }
    .search-box button { padding: 10px 16px; background: #475569; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500; transition: background-color 0.2s; }
    .search-box button:hover { background: #334155; }
</style>
</head>
<body>

    <!-- CABEÇALHO COM INFORMAÇÕES DA SESSÃO DO USUÁRIO -->
    <div class="header">
        <h2>Painel de Clientes & Relacionamentos</h2>
        <div>
            <!-- BLOCO EJS: Imprime o nome do usuário logado armazenado em req.session.usuario -->
            <span>Bem-vindo <strong><%= usuario.nome %></strong>!</span> | 
            <a href="/logout" style="color: #dc3545; text-decoration: none;">Sair</a>
        </div>
    </div>

    <!-- BARRA DE AÇÕES: LINKS DE CADASTRO E BUSCA -->
    <div class="actions">
        <div>
            <a href="/clientes/novo" class="btn btn-green">+ Cadastrar Cliente</a>
            <a href="/grupos" class="btn btn-purple">Gerenciar Grupos</a>
        </div>

        <!-- FORMULÁRIO DE FILTRO VIA QUERY STRING -->
        <form action="/clientes" method="GET" class="search-box">
            <input type="text" name="busca" placeholder="Buscar por cliente ou grupo..." value="<%= busca %>">
            <button type="submit">Buscar</button>
            <% if (busca) { %>
                <a href="/clientes" style="margin-left: 5px; font-size: 13px; color: #6c757d;">Limpar filtro</a>
            <% } %>
        </form>
    </div>

    <!-- TABELA PRINCIPAL COM EXIBIÇÃO DA COLUNA RELACIONAL (DESCRICAO_GRUPO) -->
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome Completo</th>
                <th>CPF</th>
                <th>E-mail</th>
                <th>Telefone</th>
                <th>Grupo_ID</th>
            </tr>
        </thead>
        <tbody>
            <% if (clientes.length === 0) { %>
                <tr>
                    <td colspan="6" style="text-align: center; color: #888;">Nenhum cliente encontrado.</td>
                </tr>
            <% } else { %>
                <!-- BLOCO EJS: Iteração sobre o array de clientes retornado pela consulta com LEFT JOIN -->
                <% clientes.forEach(cliente => { %>
                    <tr>
                        <td><%= cliente.id %></td>
                        <td><strong><%= cliente.nome_completo %></strong></td>
                        <td><%= cliente.cpf %></td>
                        <td><%= cliente.email %></td>
                        <td><%= cliente.telefone %></td>
                        <td><%= cliente.grupo_id %></td>
               <td>
                            <% if (cliente.descricao_grupo) { %>
                                <span class="badge-grupo"><%= cliente.descricao_grupo %></span>
                            <% } else { %>
                                <span style="color: #999; font-style: italic;">Sem Grupo</span>
                            <% } %>
                        </td>

                        <td>
                            <a href="/clientes/editar/<%= cliente.id %>" class="btn btn-blue">Editar</a>
                            <a href="/clientes/deletar/<%= cliente.id %>" class="btn btn-red" onclick="return confirm('Tem certeza que deseja excluir?')">Deletar</a>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>

</body>
</html>